FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "./system/input_par"

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }


    upWall
    {
        type           constantAlphaContactAngle;
        theta0         50;
        limit          gradient;
        value          uniform 0;
    }

    lowerWall
    {

/*
        type           constantAlphaContactAngle;
        theta0         50;
        limit          gradient;
        value          uniform 0;
*/


	type           forceBalanceContactAngle;
        theta0         $thetaEq;
        thetaA         $thetaAdv;
        thetaR         $thetaRec;
	kk	       $kk;
        limit          gradient;
        value          uniform 0;

    }

    frontWall
    {
        type           constantAlphaContactAngle;
        theta0         50;
        limit          gradient;
        value          uniform 0;
    }

    backWall
    {
        type           constantAlphaContactAngle;
        theta0         50;
        limit          gradient;
        value          uniform 0;
    }

}

// ************************************************************************* //
