FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "./system/input_par"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    inlet
    {

	type         uniformFixedValue;
    	uniformValue
    	{
        type             scale;
        scale            linearRamp;
        start            $t;
        duration         0.00001;
        value            ($V_in 0 0);
	}
    }

    outlet
    {
        type            zeroGradient;
    }


    upWall
    {
        type            noSlip;
    }

    lowerWall
    {
        type            noSlip;
    }

    frontWall
    {
        type            noSlip;
    }

    backWall
    {
        type            noSlip;
    }
}


