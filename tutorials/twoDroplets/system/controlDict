FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
	"libforceBalanceCA.so"
);

#include "./system/input_par"

application     forceBalanceCAFoam;

startFrom       $start_where;

startTime       $T_start;

stopAt          endTime;

endTime         $T_end;

deltaT          0.00001;

writeControl    adjustableRunTime;

writeInterval   $T_write;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;
maxAlphaCo      1;

maxDeltaT       1;


// ************************************************************************* //
